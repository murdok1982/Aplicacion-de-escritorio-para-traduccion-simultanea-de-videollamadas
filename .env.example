# BabelPipe — plantilla de entorno (ARCHITECTURE.md §3)
# Copiar a .env y rellenar el token. NUNCA commitear .env (ver .gitignore).
# El prefijo BABELPIPE_ evita colisiones con otras aplicaciones del sistema.

# --- Servidor de inferencia -------------------------------------------------
# En LAN: usar wss:// y un token no vacio. En localhost el token es opcional.
BABELPIPE_SERVER_HOST=127.0.0.1
BABELPIPE_SERVER_PORT=8765
BABELPIPE_SERVER_TOKEN=

# --- Nodos y mezcla de audio ------------------------------------------------
BABELPIPE_AUDIO_RX_SINK=Translator_Rx_Sink
BABELPIPE_AUDIO_TX_SOURCE=Translator_Tx_Mic
# Rango legal 0.10-0.15 (SPEC REQ-05).
BABELPIPE_AUDIO_DUCK_LEVEL=0.12
BABELPIPE_AUDIO_ECHO_CANCEL=true
BABELPIPE_AUDIO_PTT_ENABLED=false

# --- Pipeline de idiomas ----------------------------------------------------
# ISO 639-1. rx/tx se derivan de esta pareja segun el modo.
BABELPIPE_PIPELINE_SOURCE_LANG=en
BABELPIPE_PIPELINE_TARGET_LANG=es
BABELPIPE_PIPELINE_STT=faster-whisper
BABELPIPE_PIPELINE_TRANSLATOR=opus-mt
BABELPIPE_PIPELINE_TTS=kokoro

# --- Rutas de modelos -------------------------------------------------------
# Vacíos = usar los directorios por defecto del caché de cada motor.
BABELPIPE_MODEL_STT_PATH=
BABELPIPE_MODEL_TRANSLATOR_PATH=
BABELPIPE_MODEL_TTS_PATH=
